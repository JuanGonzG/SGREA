# Copiar a .env o exportar estas variables antes de iniciar SGREA.
# No colocar secretos reales en este archivo.

SPRING_DATASOURCE_URL=jdbc:mariadb://localhost:3306/sgrea?useSSL=false&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=<usuario-mariadb>
SPRING_DATASOURCE_PASSWORD=<contraseña-mariadb>

# Debe tener al menos 32 bytes.
SGREA_JWT_SECRET=<secreto-jwt-de-32-bytes-o-mas>
SGREA_JWT_ACCESS_EXPIRATION_MS=900000
SGREA_JWT_REFRESH_EXPIRATION_MS=604800000
SGREA_JWT_COOKIE_SECURE=false
